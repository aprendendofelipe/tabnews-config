{
  "name": "barso",
  "version": "0.7.1",
  "description": "Configurações compartilhadas para projetos JS/TS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./eslint": {
      "types": "./src/shared/eslint.config.d.cts",
      "default": "./src/shared/eslint.config.cjs"
    },
    "./lint-staged": {
      "types": "./src/shared/lint-staged.d.cts",
      "default": "./src/shared/lint-staged.cjs"
    },
    "./package.json": "./package.json",
    "./prettier": {
      "types": "./src/shared/prettier.config.d.cts",
      "default": "./src/shared/prettier.config.cjs"
    },
    "./vitest": {
      "types": "./src/shared/vitest.config.d.ts",
      "default": "./src/shared/vitest.config.js"
    }
  },
  "bin": {
    "barso": "bin/tn.js",
    "tn": "bin/tn.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "barso": "barso",
    "build:types": "node -e \"fs.globSync('src/**/*.d.*').forEach(f => fs.unlinkSync(f))\" && tsc -p tsconfig.build.json",
    "pretest": "pnpm build:types",
    "test": "barso test run --reporter agent",
    "test:run": "barso test run",
    "test:watch": "barso test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "commit": "cz",
    "prepare": "pnpm build:types && husky",
    "pre-commit": "lint-staged"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-import": "npm:@barso/eslint-plugin-import@2.32.0-eslint10-preview.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-primer-react": "9.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "22.13.0",
    "barso": "file:",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "typescript": "6.0.3"
  },
  "author": "aprendendofelipe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aprendendofelipe/barso.git"
  },
  "keywords": [
    "cli",
    "config",
    "tabnews"
  ]
}
